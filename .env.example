# Copy to .env.local for development or .env for Docker; never commit real secrets.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_DRIVER=filesystem
UPLOAD_DIR=/data/uploads
LOCAL_DATA_DIR=

# Required for local member signup: create a Resend API key and verify the sender domain.
# Six digit verification codes expire after 10 minutes.
RESEND_API_KEY=
AUTH_EMAIL_FROM=

# Use your actual hostname in Turnstile configuration.
CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=
# Generate a long random secret; used to hash rate-limit identifiers.
RATE_LIMIT_SECRET=
# Set true ONLY if NAS origin cannot be reached outside Cloudflare Tunnel.
TRUST_CLOUDFLARE=false
MAX_PUBLIC_UPLOAD_MB=10
MAX_ADMIN_UPLOAD_MB=250

# Optional mail adapter. POST JSON to your configured provider adapter.
CONTACT_RECEIVER_EMAIL=
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_TOKEN=

# Antivirus adapter: POST raw file, respond {"status":"clean"|"infected"}.
# Without this, uploads stay pending until a super admin attests an external scan.
MALWARE_SCAN_URL=
MALWARE_SCAN_TOKEN=

# Optional Compose profile tunnel; create the tunnel in your own Cloudflare account.
CLOUDFLARE_TUNNEL_TOKEN=

# Only needed for one-time first-admin creation. Remove afterwards.
ADMIN_EMAIL=
ADMIN_DISPLAY_NAME=
ADMIN_PASSWORD=
